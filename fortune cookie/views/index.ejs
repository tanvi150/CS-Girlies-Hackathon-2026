<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Fortune Cookie' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <%- include('partials/header') %>
    
    <nav class="nav-tabs">
      <button class="nav-tab active" data-tab="new">New Fortune</button>
      <button class="nav-tab" data-tab="jar">Fortune Jar</button>
      <button class="nav-tab" data-tab="daily">Daily</button>
    </nav>
    
    <div class="tab-content active" id="tab-new">
      <div class="fortune-card" id="fortuneApp">
        <div class="step">
          <span class="step-label">How are you feeling right now?</span>
          <input type="text" 
                 class="text-input" 
                 id="moodInput" 
                 placeholder="e.g., nervous about my interview, excited for the weekend, contemplative..."
                 maxlength="200"
                 autocomplete="off">
          <div class="input-hint">Be specific for a more personalized fortune</div>
          <div class="suggestion-chips" id="suggestionChips">
            <button class="suggestion-chip" data-value="Nervous about interview">Nervous about interview</button>
            <button class="suggestion-chip" data-value="Excited for weekend">Excited for weekend</button>
            <button class="suggestion-chip" data-value="Contemplative">Contemplative</button>
            <button class="suggestion-chip" data-value="Anxious about change">Anxious about change</button>
            <button class="suggestion-chip" data-value="Hopeful about future">Hopeful about future</button>
            <button class="suggestion-chip" data-value="Grateful for today">Grateful for today</button>
          </div>
        </div>
        
        <button class="btn-crack" id="crackBtn" disabled>
          Crack My Cookie
        </button>
        
        <div id="cookieContainer" style="display: none;">
          <div class="cookie-container" id="cookie3D">
            <div class="cookie-wrapper" id="cookieWrapper">
              <div class="fortune-cookie-3d cookie-front">
                <svg class="cookie-svg" viewBox="0 0 240 220" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <radialGradient id="cookieGrad" cx="50%" cy="40%" r="60%">
                      <stop offset="0%" stop-color="#f5d6a8"/>
                      <stop offset="40%" stop-color="#e8c97a"/>
                      <stop offset="80%" stop-color="#d4a857"/>
                      <stop offset="100%" stop-color="#b8943f"/>
                    </radialGradient>
                    <radialGradient id="foldGrad" cx="50%" cy="50%" r="50%">
                      <stop offset="0%" stop-color="#d4a857" stop-opacity="0.8"/>
                      <stop offset="100%" stop-color="#b8943f" stop-opacity="0.3"/>
                    </radialGradient>
                    <filter id="cookieShadow">
                      <feDropShadow dx="2" dy="4" stdDeviation="6" flood-opacity="0.3"/>
                    </filter>
                  </defs>
                  
                  <path class="cookie-body" d="
                    M 50 120 
                    C 30 100, 20 70, 40 50 
                    C 60 30, 90 25, 120 30 
                    C 150 25, 180 30, 200 50 
                    C 220 70, 210 100, 190 120 
                    C 180 140, 160 160, 120 165 
                    C 80 160, 60 140, 50 120 Z
                  " filter="url(#cookieShadow)"/>
                  
                  <path class="cookie-fold" d="
                    M 55 115
                    C 70 100, 90 90, 120 88
                    C 150 90, 170 100, 185 115
                  "/>
                  
                  <path class="cookie-fold" d="
                    M 60 125
                    C 80 110, 100 102, 120 100
                    C 140 102, 160 110, 180 125
                  "/>
                  
                  <circle cx="80" cy="70" r="3" fill="rgba(139,90,43,0.15)"/>
                  <circle cx="160" cy="70" r="3" fill="rgba(139,90,43,0.15)"/>
                  <circle cx="100" cy="55" r="2" fill="rgba(139,90,43,0.12)"/>
                  <circle cx="140" cy="55" r="2" fill="rgba(139,90,43,0.12)"/>
                  <circle cx="70" cy="100" r="2" fill="rgba(139,90,43,0.10)"/>
                  <circle cx="170" cy="100" r="2" fill="rgba(139,90,43,0.10)"/>
                  <circle cx="90" cy="135" r="2" fill="rgba(139,90,43,0.10)"/>
                  <circle cx="150" cy="135" r="2" fill="rgba(139,90,43,0.10)"/>
                </svg>
                
                <div class="crack-overlay" id="crackOverlay"></div>
              </div>
              
              <div class="fortune-cookie-3d cookie-back">
                <svg class="cookie-svg" viewBox="0 0 240 220" xmlns="http://www.w3.org/2000/svg">
                  <defs>
                    <radialGradient id="cookieInside" cx="50%" cy="40%" r="60%">
                      <stop offset="0%" stop-color="#f0dbb8"/>
                      <stop offset="50%" stop-color="#e0c49a"/>
                      <stop offset="100%" stop-color="#c9a87a"/>
                    </radialGradient>
                  </defs>
                  
                  <path class="cookie-body" d="
                    M 50 120 
                    C 30 100, 20 70, 40 50 
                    C 60 30, 90 25, 120 30 
                    C 150 25, 180 30, 200 50 
                    C 220 70, 210 100, 190 120 
                    C 180 140, 160 160, 120 165 
                    C 80 160, 60 140, 50 120 Z
                  " fill="url(#cookieInside)" stroke="#b8943f" stroke-width="2"/>
                  
                  <ellipse cx="120" cy="95" rx="60" ry="40" fill="#2c1810" opacity="0.3"/>
                  <ellipse cx="120" cy="95" rx="50" ry="32" fill="#1a0f05" opacity="0.2"/>
                </svg>
              </div>
            </div>
            
            <div class="fortune-paper" id="fortunePaper">
              <div class="paper-text" id="paperText">Your fortune will appear here</div>
              <div class="paper-number" id="paperNumber">Lucky Number</div>
              <div class="paper-challenge" id="paperChallenge">Today's challenge</div>
            </div>
          </div>
        </div>
        
        <div id="fortuneResult" style="display: none;"></div>
      </div>
    </div>
    
    <div class="tab-content" id="tab-jar">
      <div class="fortune-jar">
        <h2>Fortune Jar</h2>
        <p class="subtitle">All the wisdom you have collected</p>
        <div id="jarEntries">
          <p style="color: var(--text-secondary); font-style: italic; text-align: center; padding: 2rem;">
            No fortunes yet. Crack your first cookie.
          </p>
        </div>
        <button class="btn-secondary" id="clearJarBtn" style="width: 100%; margin-top: 1rem;">
          Clear All
        </button>
      </div>
    </div>
    
    <div class="tab-content" id="tab-daily">
      <div class="daily-fortune">
        <h2>Daily Fortune</h2>
        <p class="subtitle">Your daily dose of optimism</p>
        <div id="dailyContent">
          <button class="btn-crack" id="dailyBtn">
            Get Today's Fortune
          </button>
        </div>
      </div>
    </div>
  </div>
  
  <script src="/main.js"></script>
</body>
</html>